{
  "name": "valerie-chat-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name valerie-chat",
    "set-password": "npx wrangler pages secret put SITE_PASSWORD --project-name valerie-chat",
    "deploy:netlify": "npx netlify-cli deploy --prod",
    "deploy:vercel": "npx vercel deploy --prod"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@paper-design/shaders": "0.0.81",
    "@paper-design/shaders-react": "0.0.81",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
